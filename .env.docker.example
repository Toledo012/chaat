# ============================================================
#  SEMAHN Tickets — .env de PRODUCCIÓN para Docker
#  cp .env.docker.example .env   y reemplaza todos los "changeme"
#  Passwords: SOLO letras, números y _  (Docker Compose interpreta $)
# ============================================================

APP_NAME="SEMAHN Tickets"
APP_ENV=production
APP_DEBUG=false
# Genera con: docker compose run --rm --no-deps --entrypoint php app artisan key:generate --show
APP_KEY=
APP_URL=https://semahnchiapas.com.mx
SISTEMA_URL=https://semahnchiapas.com.mx

# === Dominio / SSL (Let's Encrypt) ===
# Sin certificado, Nginx arranca en HTTP; con ./scripts/init-ssl.sh se activa HTTPS solo.
DOMAIN=semahnchiapas.com.mx
LETSENCRYPT_EMAIL=changeme@changeme.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# === Base de datos (contenedor "db") ===
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=semahntickets
DB_USERNAME=semahn_app
DB_PASSWORD=changeme_app_password
DB_ROOT_PASSWORD=changeme_root_password_distinta

# === Sesión / cache / colas ===
# file: no depende de tablas extra en la BD. Los correos se envían síncronos.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true cuando ya haya HTTPS (cookies solo por https)
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# === Correo (SMTP real) ===
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.changeme.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=changeme@changeme.com
MAIL_PASSWORD=changeme_smtp_password
MAIL_FROM_ADDRESS="changeme@changeme.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
